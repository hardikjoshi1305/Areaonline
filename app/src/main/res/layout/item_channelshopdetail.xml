<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollIndicators="none"
        android:scrollbars="none">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/_75sdp"
            android:orientation="horizontal"
            android:background="@color/whiteCardColor"
            android:layout_marginLeft="@dimen/_5sdp"
            android:layout_marginRight="@dimen/_5sdp"
            android:layout_marginBottom="@dimen/_5sdp">

            <TextView
                android:id="@+id/tv_srno"
                android:layout_width="@dimen/_35sdp"
                android:layout_height="match_parent"
                android:background="@drawable/search_layout_black"
                android:gravity="center"
                android:text=""
                android:textColor="@color/black"
                 android:textSize="@dimen/_11sdp" />

            <LinearLayout
                android:layout_width="@dimen/_75sdp"
                android:layout_height="match_parent"
                android:background="@drawable/search_layout_black"
                android:gravity="center"

                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iv_logo"
                    android:layout_width="@dimen/_65sdp"
                    android:layout_height="match_parent"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:layout_marginBottom="@dimen/_7sdp"
                    android:gravity="center"
                    android:src="@drawable/placeholder2"
                    android:scaleType="centerInside"
                     />
            </LinearLayout>


            <TextView
                android:id="@+id/tv_companyname"
                android:layout_width="@dimen/_75sdp"
                android:layout_height="match_parent"
                android:background="@drawable/search_layout_black"
                android:gravity="center"
                android:text=""
                android:textColor="@color/black"
                 android:textSize="@dimen/_11sdp" />

            <TextView
                android:id="@+id/tv_bussineesstype"
                android:layout_width="@dimen/_80sdp"
                android:layout_height="match_parent"
                android:background="@drawable/search_layout_black"
                android:gravity="center"
                android:text=""
                android:textColor="@color/black"
                 android:textSize="@dimen/_11sdp" />

            <TextView
                android:id="@+id/tv_category"
                android:layout_width="@dimen/_85sdp"
                android:layout_height="match_parent"
                android:background="@drawable/search_layout_black"
                android:gravity="center"
                android:paddingLeft="@dimen/_2sdp"
                android:paddingRight="@dimen/_2sdp"

                android:text=""
                android:textColor="@color/black"
                 android:textSize="@dimen/_11sdp" />

            <LinearLayout
                android:layout_width="@dimen/_110sdp"
                android:layout_height="match_parent"
                android:background="@drawable/search_layout_black"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/line_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginRight="@dimen/_6sdp"
                    android:layout_marginLeft="@dimen/_6sdp"
                    android:background="@drawable/btn_rounded_primary"
                    android:backgroundTint="@color/red_bg"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/_14sdp"
                        android:layout_height="@dimen/_14sdp"
                        android:layout_gravity="center"
                        android:layout_marginLeft="@dimen/_7sdp"
                        android:visibility="gone"
                        app:srcCompat="@drawable/ic_baseline_check_24" />

                    <TextView
                        android:id="@+id/tv_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:singleLine="true"
                        android:text="Pending"
                        android:textColor="@color/white"
                         android:textSize="@dimen/_11sdp" />


                </LinearLayout>


            </LinearLayout>

            <LinearLayout
                android:layout_width="@dimen/_96sdp"
                android:layout_height="match_parent"
                android:background="@drawable/search_layout_black"
                android:gravity="center"
                android:paddingRight="@dimen/_2sdp"
                android:paddingLeft="@dimen/_2sdp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/lin_viewdetail"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_28sdp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginRight="@dimen/_2sdp"
                    android:layout_weight="1"
                    android:background="@drawable/circle_bg"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:padding="@dimen/_7sdp"
                        android:layout_weight="1"
                        app:srcCompat="@drawable/ic_baseline_remove_red_eye_24"
                        app:tint="@color/white" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/line_edit"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_28sdp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginRight="@dimen/_2sdp"
                    android:layout_weight="1"
                    android:background="@drawable/circle_bg"
                    android:backgroundTint="@color/blue_light"

                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:padding="@dimen/_7sdp"
                        android:layout_weight="1"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_baseline_border_color_24"
                        app:tint="@color/white" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/line_delete"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_28sdp"
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/circle_bg"
                    android:layout_weight="1"
                    android:layout_marginRight="@dimen/_2sdp"
                    android:backgroundTint="@color/black"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:layout_weight="1"
                        android:padding="@dimen/_7sdp"
                        app:srcCompat="@drawable/ic_baseline_delete_24"
                        app:tint="@color/white" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </HorizontalScrollView>

</LinearLayout>