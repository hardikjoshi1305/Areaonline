<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical">
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollIndicators="none"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/_35sdp"
                android:layout_marginLeft="@dimen/_5sdp"
                android:layout_marginTop="@dimen/_5sdp"
                android:layout_marginRight="@dimen/_5sdp"
                android:background="@color/whiteCardColor"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_slno"
                    android:layout_width="@dimen/_35sdp"
                    android:layout_height="match_parent"
                    android:background="@drawable/search_layout_black"
                    android:gravity="center"
                    android:text="SI.No"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_11sdp" />

                <TextView
                    android:id="@+id/tv_upiid"
                    android:layout_width="@dimen/_115sdp"
                    android:layout_height="match_parent"
                    android:background="@drawable/search_layout_black"
                    android:gravity="center"
                    android:text="UPI ID"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_11sdp" />

                <TextView
                    android:id="@+id/tv_bankname"
                    android:layout_width="@dimen/_165sdp"
                    android:layout_height="match_parent"
                    android:background="@drawable/search_layout_black"
                    android:gravity="center"
                    android:text="Bank Name"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_11sdp" />

                <TextView
                    android:id="@+id/tv_branchname"
                    android:layout_width="@dimen/_165sdp"
                    android:layout_height="match_parent"
                    android:background="@drawable/search_layout_black"
                    android:gravity="center"
                    android:text="Branch Name"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_11sdp" />

                <TextView
                    android:id="@+id/tv_accountholder"
                    android:layout_width="@dimen/_160sdp"
                    android:layout_height="match_parent"
                    android:background="@drawable/search_layout_black"
                    android:gravity="center"
                    android:text="Account Holder"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_11sdp" />

                <TextView
                    android:id="@+id/tv_accountnumber"
                    android:layout_width="@dimen/_160sdp"
                    android:layout_height="match_parent"
                    android:background="@drawable/search_layout_black"
                    android:gravity="center"
                    android:text="Account Number"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_11sdp" />

                <TextView
                    android:id="@+id/tv_ifsc"
                    android:layout_width="@dimen/_160sdp"
                    android:layout_height="match_parent"
                    android:background="@drawable/search_layout_black"
                    android:gravity="center"
                    android:text="IFSC Code"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_11sdp" />

                <TextView
                    android:id="@+id/tv_default"
                    android:layout_width="@dimen/_85sdp"
                    android:layout_height="match_parent"
                    android:background="@drawable/search_layout_black"
                    android:gravity="center"

                    android:text="Is Default?"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_11sdp" />

                <TextView
                    android:id="@+id/tv_status"
                    android:layout_width="@dimen/_90sdp"
                    android:layout_height="match_parent"
                    android:background="@drawable/search_layout_black"
                    android:gravity="center"
                    android:text="Status"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_11sdp" />
                <LinearLayout
                    android:layout_width="@dimen/_120sdp"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:id="@+id/line_edit"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginLeft="@dimen/_3sdp"
                        android:layout_marginTop="@dimen/_3sdp"
                        android:layout_marginRight="@dimen/_3sdp"
                        android:layout_marginBottom="@dimen/_3sdp"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:layout_weight="1"
                        android:background="@drawable/btn_rounded_primary"
                        android:backgroundTint="@color/blue_light"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_edit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:text="Edit"
                            android:textColor="@color/white"
                            android:textSize="@dimen/_10sdp" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/line_delete"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginTop="@dimen/_3sdp"
                        android:layout_marginRight="@dimen/_3sdp"
                        android:layout_marginBottom="@dimen/_3sdp"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:layout_weight="1"
                        android:background="@drawable/btn_rounded_primary"
                        android:backgroundTint="@color/red"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_delete"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:text="Delete"
                            android:textColor="@color/white"
                            android:textSize="@dimen/_10sdp" />
                    </LinearLayout>

                </LinearLayout>



            </LinearLayout>
        </LinearLayout>
    </HorizontalScrollView>

</LinearLayout>