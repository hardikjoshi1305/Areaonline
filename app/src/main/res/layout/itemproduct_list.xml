<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rel_list_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/_7sdp"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/_3sdp"
                android:layout_marginTop="@dimen/_6sdp"
                android:layout_marginRight="@dimen/_3sdp"
                android:layout_weight="1.3">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="@dimen/_4sdp">

                    <ImageView
                        android:id="@+id/iv_listing"
                        android:layout_width="@dimen/_100sdp"
                        android:layout_height="@dimen/_100sdp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/hotel_img" />


                </androidx.cardview.widget.CardView>
            </RelativeLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/_8sdp"
                android:layout_marginTop="@dimen/_3sdp"
                android:layout_weight="0.7"

                android:orientation="vertical">


                    <TextView
                        android:id="@+id/tv_itemtype"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Home Decor"
                        android:textColor="@color/grey"
                        android:textSize="@dimen/_10sdp" />



                <TextView
                    android:id="@+id/tv_itemname"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_4sdp"
                    android:singleLine="true"
                    android:text="vvvvvvvv"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_11sdp" />

                <TextView
                    android:id="@+id/tv_itemdes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="vvvvvvvvvvvv "
                    android:textColor="@color/grey"
                    android:textSize="@dimen/_11sdp" />


                <LinearLayout
                    android:id="@+id/line_rating"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="@dimen/_8sdp"
                    android:layout_marginTop="@dimen/_3sdp"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@color/red_bg"
                        android:padding="@dimen/_3sdp"
                        android:text="4.5"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_8sdp" />

                    <RatingBar
                        style="@style/Widget.AppCompat.RatingBar.Small"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginLeft="@dimen/_5sdp"
                        android:numStars="5"
                        android:progressTint="@color/golden"
                        android:rating="4.5" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rel_add"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginLeft="@dimen/_7sdp"
                    android:layout_marginTop="@dimen/_9sdp"

                    android:layout_marginBottom="@dimen/_9sdp"
                    android:layout_weight="1.2"
                    android:gravity="start"
                    android:orientation="horizontal">

                    <RelativeLayout
                        android:id="@+id/rel_orgprice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">

                        <View
                            android:layout_width="@dimen/_30sdp"
                            android:layout_height="@dimen/_1sdp"
                            android:layout_centerVertical="true"
                            android:background="@color/grey_light2222" />

                        <TextView
                            android:id="@+id/tv_orignalprice"
                            android:layout_width="@dimen/_40sdp"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text=""
                            android:textColor="@color/grey_light2222"
                            android:textSize="@dimen/_11sdp"
                            app:fontFamily="sans-serif-medium" />
                    </RelativeLayout>


                    <TextView
                        android:id="@+id/tv_amount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="@dimen/_17sdp"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:text="100$"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_11sdp"
                        app:fontFamily="sans-serif-medium" />

                    <ImageButton
                        android:id="@+id/ib_minus"
                        android:layout_width="@dimen/_17sdp"
                        android:layout_height="@dimen/_17sdp"
                        android:layout_centerVertical="true"
                        android:layout_toLeftOf="@id/tv_amount"
                        android:background="@drawable/search_layout"
                        android:scaleType="centerCrop"
                        app:srcCompat="@drawable/ic_remove"
                        app:tint="@color/red_bg" />

                    <TextView
                        android:id="@+id/tv_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginLeft="@dimen/_7sdp"
                        android:layout_marginRight="@dimen/_7sdp"
                        android:fontFamily="sans-serif-medium"
                        android:text="0"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_11sdp"
                        app:fontFamily="sans-serif-medium" />

                    <ImageButton
                        android:id="@+id/ib_add"
                        android:layout_width="@dimen/_17sdp"
                        android:layout_height="@dimen/_17sdp"
                        android:layout_marginRight="@dimen/_20sdp"
                        android:background="@drawable/search_layout"
                        android:backgroundTint="@color/red_bg"
                        android:scaleType="centerCrop"
                        app:srcCompat="@drawable/ic_add"
                        app:tint="@color/white" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/_1sdp"
            android:background="@color/grey_light" />
    </LinearLayout>
</LinearLayout>