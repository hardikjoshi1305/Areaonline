<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/swipeRefreshLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:animateLayoutChanges="true">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:layout_width="wrap_content"
            android:id="@+id/fab_chat"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_baseline_chat_24"
            android:backgroundTint="@color/red_bg"
            app:layout_dodgeInsetEdges="bottom"
            app:tint="@color/white"
            android:layout_gravity="bottom|right"
            android:layout_margin="@dimen/_7sdp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:animateLayoutChanges="true"
            android:background="@color/grey_lightest"
            android:orientation="vertical">

            <RelativeLayout
                android:id="@+id/relmain"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <androidx.cardview.widget.CardView
                    android:id="@+id/homeToolbarLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/red_bg"
                    android:elevation="@dimen/_4sdp"

                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/_45sdp">

                            <ImageView
                                android:id="@+id/iv_login"
                                android:layout_width="@dimen/_30sdp"
                                android:layout_height="@dimen/_30sdp"
                                android:layout_marginEnd="@dimen/_5sdp"
                                android:layout_marginRight="@dimen/_5sdp"
                                android:background="?attr/selectableItemBackground"
                                android:contentDescription="@string/image_view_content_description"
                                android:visibility="visible"
                                app:layout_constraintBottom_toBottomOf="@+id/searchImageView"
                                app:layout_constraintEnd_toStartOf="@+id/searchImageView"
                                app:layout_constraintTop_toTopOf="@+id/searchImageView"
                                app:srcCompat="@drawable/ic_baseline_person_24" />

                            <ImageView
                                android:id="@+id/searchImageView"
                                android:layout_width="@dimen/_30sdp"
                                android:layout_height="@dimen/_30sdp"
                                android:layout_marginEnd="@dimen/_5sdp"
                                android:layout_marginRight="@dimen/_5sdp"
                                android:background="?attr/selectableItemBackground"
                                android:contentDescription="@string/image_view_content_description"
                                android:onClick="onClick"
                                android:padding="@dimen/_5sdp"
                                android:visibility="gone"
                                app:layout_constraintBottom_toBottomOf="@+id/helpImageView"
                                app:layout_constraintEnd_toStartOf="@+id/helpImageView"
                                app:layout_constraintTop_toTopOf="@+id/helpImageView"
                                app:srcCompat="@drawable/ic_baseline_search_24"
                                app:tint="@color/white" />

                            <TextView
                                android:id="@+id/appTitleTextView"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/_10sdp"
                                android:layout_marginLeft="@dimen/_10sdp"
                                android:fontFamily="@font/inter_semibold"
                                android:gravity="center_vertical"
                                android:maxLines="1"
                                android:minHeight="@dimen/_30sdp"
                                android:paddingStart="@dimen/_8sdp"
                                android:paddingLeft="@dimen/_8sdp"
                                android:paddingEnd="@dimen/_5sdp"
                                android:paddingRight="@dimen/_5sdp"
                                android:text="@string/app_name"
                                android:textColor="@color/white"
                                android:textSize="@dimen/_16sdp"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintLeft_toRightOf="@id/toggle"
                                app:layout_constraintTop_toTopOf="parent" />

                            <ImageView
                                android:id="@+id/toggle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/_4sdp"
                                android:layout_marginLeft="@dimen/_4sdp"
                                android:gravity="center_vertical"
                                android:maxLines="1"
                                android:minHeight="@dimen/_30sdp"
                                android:paddingStart="@dimen/_8sdp"
                                android:paddingLeft="@dimen/_8sdp"
                                android:paddingEnd="@dimen/_5sdp"
                                android:paddingRight="@dimen/_5sdp"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:srcCompat="@drawable/ic_baseline_menu_24"
                                app:tint="@color/white" />

                            <ImageView
                                android:id="@+id/helpImageView"
                                android:layout_width="@dimen/_30sdp"
                                android:layout_height="@dimen/_30sdp"
                                android:layout_marginEnd="@dimen/_4sdp"
                                android:layout_marginRight="@dimen/_4sdp"
                                android:background="?attr/selectableItemBackground"
                                android:padding="@dimen/_4sdp"
                                android:visibility="visible"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:srcCompat="@drawable/ic_baseline_support_agent_24"
                                app:tint="@color/white" />
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_50sdp"
                    android:layout_below="@id/homeToolbarLayout"
                    android:background="@color/red_bg"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingBottom="@dimen/_3sdp"

                    android:visibility="gone">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_40sdp"
                        android:layout_marginLeft="@dimen/_10sdp"
                        android:layout_marginRight="@dimen/_10sdp"
                        android:layout_weight="1"
                        android:gravity="center_vertical"

                        >

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_searchmain"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_gravity="center_vertical"
                            android:background="@drawable/round_ett"
                            android:clickable="false"
                            android:drawableLeft="@drawable/ic_baseline_search_24"
                            android:drawablePadding="@dimen/_8sdp"
                            android:drawableTint="@color/red_bg"
                            android:focusable="false"
                            android:gravity="center_vertical"
                            android:hint="What are You looking for?"
                            android:textSize="@dimen/_10sdp" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <!--                <com.google.android.material.textfield.TextInputLayout-->
                    <!--                    android:layout_width="match_parent"-->
                    <!--                    android:layout_height="@dimen/_40sdp"-->
                    <!--                    android:layout_weight="1"-->
                    <!--                    android:layout_marginRight="@dimen/_5sdp"-->
                    <!--                    android:gravity="center_vertical"-->
                    <!--                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"-->

                    <!--                    >-->
                    <!--                    <com.google.android.material.textfield.TextInputEditText-->
                    <!--                        android:layout_width="match_parent"-->
                    <!--                        android:layout_height="match_parent"-->
                    <!--                        android:gravity="center_vertical"-->
                    <!--                        android:clickable="false"-->
                    <!--                        android:focusable="false"-->
                    <!--                        android:textSize="@dimen/_10sdp"-->
                    <!--                        android:layout_gravity="center_vertical"-->
                    <!--                        android:background="@drawable/round_ett"-->
                    <!--                        android:drawableLeft="@drawable/ic_baseline_location_on_24"-->
                    <!--                        android:drawableTint="@color/red_bg"-->
                    <!--                        android:drawablePadding="@dimen/_4sdp"-->
                    <!--                        android:hint="Enter Your Location"/>-->
                    <!--                </com.google.android.material.textfield.TextInputLayout>-->

                    <!--                <ImageView-->
                    <!--                    android:layout_width="wrap_content"-->
                    <!--                    android:layout_height="wrap_content"-->
                    <!--                    android:padding="@dimen/_5sdp"-->
                    <!--                    app:srcCompat="@drawable/ic_baseline_search_2"-->
                    <!--                    android:scaleType="fitXY"-->

                    <!--                    android:layout_marginRight="@dimen/_5sdp"-->
                    <!--                    android:layout_gravity="center"-->
                    <!--                    app:tint="@color/white" />-->


                </androidx.appcompat.widget.LinearLayoutCompat>

            </RelativeLayout>


            <androidx.core.widget.NestedScrollView
                android:id="@+id/nestesss"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:scrollIndicators="none"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">


                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/bannerRecyclerView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:orientation="horizontal"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_4sdp"
                        android:background="@color/red_bg"
                        android:gravity="center"
                        android:orientation="vertical"

                        android:paddingTop="@dimen/_8sdp"
                        android:paddingBottom="@dimen/_13sdp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_margin="@dimen/_5sdp"
                            android:gravity="center"
                            android:text="Search your Area Shop"
                            android:textColor="@color/white"
                            android:textSize="@dimen/_13sdp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_marginRight="@dimen/_5sdp"
                                android:orientation="vertical">

                                <RelativeLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginLeft="@dimen/_10sdp"
                                    android:layout_marginRight="@dimen/_10sdp"
                                    android:gravity="center_vertical">

                                    <AutoCompleteTextView
                                        android:id="@+id/countries_list"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:layout_centerHorizontal="true"
                                        android:background="@color/white"
                                        android:completionThreshold="3"
                                        android:text=""
                                        android:textColor="#000000"
                                        android:visibility="gone" />

                                    <com.google.android.material.textfield.TextInputLayout
                                        android:id="@+id/tel1"
                                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:focusableInTouchMode="true"
                                        app:hintEnabled="false">

                                        <com.google.android.material.textfield.TextInputEditText
                                            android:id="@+id/et_SSearchfff"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_gravity="center_vertical"
                                            android:layout_marginTop="@dimen/_5sdp"
                                            android:background="@drawable/round_ett"
                                            android:drawablePadding="@dimen/_8sdp"
                                            android:drawableTint="@color/red_bg"
                                            android:gravity="center_vertical"
                                            android:hint="Search by shop name / category"
                                            android:textColor="@color/black"
                                            android:textColorHint="@color/black"
                                            android:textSize="@dimen/_10sdp"
                                            android:textStyle="bold" />
                                    </com.google.android.material.textfield.TextInputLayout>

                                    <ImageView
                                        android:id="@+id/iv_voicesearch"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_alignParentRight="true"
                                        android:layout_centerVertical="true"
                                        android:padding="@dimen/_10sdp"
                                        android:src="@drawable/ic_baseline_keyboard_voice_24"
                                        app:tint="@color/black" />
                                </RelativeLayout>


                                <RelativeLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginLeft="@dimen/_10sdp"
                                    android:layout_marginTop="@dimen/_18sdp"
                                    android:layout_marginRight="@dimen/_10sdp"
                                    android:gravity="center_vertical">

                                    <com.google.android.material.textfield.TextInputLayout
                                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"

                                        app:hintEnabled="false"

                                        >

                                        <com.google.android.material.textfield.TextInputEditText
                                            android:id="@+id/et_SLocation"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_gravity="center_vertical"
                                            android:layout_marginTop="@dimen/_5sdp"
                                            android:background="@drawable/round_ett"
                                            android:drawablePadding="@dimen/_8sdp"
                                            android:drawableTint="@color/red_bg"
                                            android:focusable="false"
                                            android:gravity="center_vertical"
                                            android:hint="Enter Your Location"
                                            android:textColor="@color/black"
                                            android:textColorHint="@color/black"
                                            android:textSize="@dimen/_10sdp"
                                            android:textStyle="bold" />
                                    </com.google.android.material.textfield.TextInputLayout>

                                    <ImageView
                                        android:id="@+id/iv_close"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_alignParentRight="true"
                                        android:layout_centerVertical="true"
                                        android:padding="@dimen/_10sdp"
                                        android:visibility="gone"
                                        android:clickable="true"

                                        android:src="@drawable/ic_baseline_close_24"
                                        app:tint="@color/black" />

                                    <ImageView
                                        android:id="@+id/iv_gps"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_alignParentRight="true"
                                        android:layout_centerVertical="true"
                                        android:padding="@dimen/_10sdp"
                                        android:clickable="true"
                                        android:src="@drawable/ic_baseline_gps_fixed_24"
                                        app:tint="@color/black" />

                                    <ProgressBar
                                        android:id="@+id/progggg"
                                        android:layout_width="@dimen/_22sdp"
                                        android:layout_height="@dimen/_22sdp"
                                        android:layout_alignParentRight="true"
                                        android:layout_centerVertical="true"
                                        android:layout_marginRight="@dimen/_8sdp"
                                        android:indeterminateTint="@color/blue_light" />
                                </RelativeLayout>

                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/lin_search"
                                android:layout_width="wrap_content"
                                android:layout_height="@dimen/_45sdp"
                                android:layout_gravity="center"
                                android:layout_marginTop="@dimen/_10sdp"
                                android:orientation="vertical"
                                android:padding="@dimen/_5sdp">

                                <com.google.android.material.card.MaterialCardView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    app:cardBackgroundColor="#F7D115"
                                    app:cardCornerRadius="@dimen/_5sdp"
                                    app:strokeColor="@color/white"
                                    app:strokeWidth="@dimen/_1sdp">

                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center"
                                        android:layout_marginLeft="@dimen/_15sdp"
                                        android:layout_marginRight="@dimen/_15sdp"
                                        android:text="Search"
                                        android:textColor="@color/white"
                                        android:textSize="@dimen/_15sdp" />
                                </com.google.android.material.card.MaterialCardView>


                            </LinearLayout>
                        </LinearLayout>


                    </LinearLayout>


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical">

                        <RelativeLayout
                            android:id="@+id/rel_1"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <View
                                android:id="@+id/vv"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/_2sdp"
                                android:layout_marginTop="@dimen/_7sdp"
                                android:background="@color/grey_light" />


                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/rec_shop"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_below="@id/vv"
                                android:layout_centerInParent="true"
                                android:layout_marginTop="@dimen/_6sdp"
                                android:layout_marginRight="@dimen/_4sdp"
                                android:nestedScrollingEnabled="false"
                                android:orientation="horizontal"
                                app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                                app:spanCount="2"
                                tools:listitem="@layout/item_main" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/_2sdp"
                                android:layout_below="@id/rec_shop"
                                android:background="@color/grey_light" />

                        </RelativeLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@color/grey_light"
                            android:orientation="horizontal"
                            android:paddingLeft="@dimen/_10sdp"
                            android:paddingTop="@dimen/_8sdp"
                            android:paddingRight="@dimen/_8sdp"
                            android:visibility="gone"
                            android:weightSum="2">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="0.5"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tv_1"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Hot Category"
                                    android:textColor="@color/black"
                                    android:textSize="@dimen/_13sdp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tv_2"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_below="@id/tv_1"
                                    android:text="@string/hot_deal"
                                    android:textColor="@color/black"
                                    android:textSize="@dimen/_11sdp"
                                    android:visibility="gone" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/line_viewall"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_vertical"
                                android:layout_weight="1.5"
                                android:gravity="right"
                                android:orientation="vertical"
                                android:visibility="invisible">

                                <Button
                                    android:layout_width="@dimen/_65sdp"
                                    android:layout_height="@dimen/_25sdp"
                                    android:background="@drawable/button_background_blue"
                                    android:fontFamily="sans-serif-black"
                                    android:text="View all"
                                    android:textAllCaps="false"
                                    android:textSize="@dimen/_8sdp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_below="@id/card"
                            android:layout_gravity="center"
                            android:background="@color/grey_light"
                            android:gravity="center"
                            android:paddingTop="@dimen/_6sdp"
                            android:paddingBottom="@dimen/_6sdp">

                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/rec_shop2"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:background="@color/grey_light"
                                android:orientation="vertical"
                                app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                                app:spanCount="2"
                                tools:listitem="@layout/item_listing" />

                            <ProgressBar
                                android:id="@+id/progresss"
                                android:layout_width="@dimen/_24sdp"
                                android:layout_height="@dimen/_24sdp"
                                android:layout_below="@id/rec_shop2"
                                android:layout_centerInParent="true"
                                android:indeterminateTint="@color/blue_light" />
                        </RelativeLayout>


                    </LinearLayout>


                </LinearLayout>
            </androidx.core.widget.NestedScrollView>

        </LinearLayout>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
