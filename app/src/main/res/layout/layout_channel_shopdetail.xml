<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/grey_lightest"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollIndicators="none"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_35sdp"
                    android:orientation="horizontal"
                    android:background="@color/whiteCardColor"
                    android:layout_marginLeft="@dimen/_5sdp"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:layout_marginRight="@dimen/_5sdp">

                    <TextView
                        android:layout_width="@dimen/_35sdp"
                        android:layout_height="match_parent"
                        android:background="@drawable/search_layout_black"
                        android:gravity="center"
                        android:text="SI.No"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_11sdp" />

                    <TextView
                        android:layout_width="@dimen/_75sdp"
                        android:layout_height="match_parent"
                        android:background="@drawable/search_layout_black"
                        android:gravity="center"
                        android:text="Image"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_11sdp" />

                    <TextView
                        android:layout_width="@dimen/_75sdp"
                        android:layout_height="match_parent"
                        android:background="@drawable/search_layout_black"
                        android:gravity="center"
                        android:text="Company Name"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_11sdp" />

                    <TextView
                        android:layout_width="@dimen/_80sdp"
                        android:layout_height="match_parent"
                        android:background="@drawable/search_layout_black"
                        android:gravity="center"
                        android:text="Bussiness Type"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_11sdp" />

                    <TextView
                        android:layout_width="@dimen/_85sdp"
                        android:layout_height="match_parent"
                        android:background="@drawable/search_layout_black"
                        android:gravity="center"

                        android:text="Category"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_11sdp" />

                    <TextView
                        android:layout_width="@dimen/_110sdp"
                        android:layout_height="match_parent"
                        android:background="@drawable/search_layout_black"
                        android:gravity="center"
                        android:text="Status"


                        android:textColor="@color/black"
                        android:textSize="@dimen/_11sdp" />

                    <TextView
                        android:layout_width="@dimen/_90sdp"
                        android:layout_height="match_parent"
                        android:background="@drawable/search_layout_black"
                        android:gravity="center"
                        android:text="Action"


                        android:textColor="@color/black"
                        android:textSize="@dimen/_11sdp" />

                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:id="@+id/rec_channelshopdetail"
                    tools:listitem="@layout/item_channelshopdetail"/>
                <LinearLayout
                    android:id="@+id/line_nodata"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_35sdp"
                    android:layout_marginLeft="@dimen/_5sdp"
                    android:layout_marginRight="@dimen/_5sdp"
                    android:layout_marginBottom="@dimen/_5sdp"
                    android:background="@drawable/search_layout_black"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:layout_margin="@dimen/_1sdp"
                        android:background="@color/whiteCardColor"
                        android:gravity="center"
                        android:text="No Data Available"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_11sdp" />


                </LinearLayout>




            </LinearLayout>


        </HorizontalScrollView>


    </LinearLayout>

</LinearLayout>