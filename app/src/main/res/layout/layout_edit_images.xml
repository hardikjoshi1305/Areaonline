<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:animateLayoutChanges="true"
    android:background="@color/grey_lightest"
    android:orientation="vertical">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollIndicators="none"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/_10sdp"
            android:layout_marginTop="@dimen/_18sdp"
            android:layout_marginRight="@dimen/_15sdp"
            android:orientation="vertical">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Shop"
                            android:textStyle="bold"
                            android:textColor="@color/red_bg"
                            android:textSize="@dimen/_16sdp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/_55sdp"
                            android:layout_weight="1"
                            android:visibility="invisible"
                            android:background="@drawable/btn_rounded_primary"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="@dimen/_18sdp"
                                android:layout_height="@dimen/_18sdp"
                                android:layout_gravity="center_vertical"
                                android:layout_marginLeft="@dimen/_9sdp"
                                android:background="@drawable/ic_baseline_refresh_24"
                                android:paddingLeft="@dimen/_5sdp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_vertical"
                                android:layout_marginLeft="@dimen/_4sdp"
                                android:paddingRight="@dimen/_5sdp"
                                android:text="Refresh"
                                android:textColor="@color/white"
                                 android:textSize="@dimen/_10sdp" />

                        </LinearLayout>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_marginTop="@dimen/_11sdp"
                        android:gravity="end"
                        android:orientation="horizontal">


                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/_40sdp"
                            android:layout_marginLeft="@dimen/_35sdp"
                            android:background="@drawable/btn_rounded_primary"
                            android:backgroundTint="@color/red_bg"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:padding="@dimen/_4sdp"

                            android:orientation="horizontal"
                            android:visibility="visible">

                            <ImageView
                                android:layout_width="@dimen/_18sdp"
                                android:layout_height="@dimen/_18sdp"
                                android:layout_gravity="center_vertical"
                                android:background="@drawable/ic_baseline_segment_24"
                               />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_vertical"
                                android:layout_marginLeft="@dimen/_2sdp"
                                android:text="Show Shop  "

                                android:textColor="@color/white"
                                 android:textSize="@dimen/_10sdp" />

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/line_addproduct"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/_40sdp"
                            android:layout_marginRight="@dimen/_10sdp"
                            android:layout_weight="1"
                            android:background="@drawable/btn_rounded_primary"
                            android:backgroundTint="@color/red_bg"

                            android:orientation="horizontal"
                            android:visibility="gone">

                            <ImageView
                                android:layout_width="@dimen/_18sdp"
                                android:layout_height="@dimen/_18sdp"
                                android:layout_gravity="center_vertical"
                                android:layout_marginLeft="@dimen/_7sdp"
                                android:background="@drawable/ic_baseline_segment_24"
                                android:paddingLeft="@dimen/_5sdp"
                                android:scaleType="centerCrop"
                                android:text="Add Shop Details" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:layout_marginLeft="@dimen/_4sdp"
                                android:paddingRight="@dimen/_5sdp"

                                android:text="Show Shop"
                                android:textColor="@color/white"
                                 android:textSize="@dimen/_10sdp" />

                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_15sdp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/_3sdp"
                    android:layout_marginRight="@dimen/_2sdp"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="horizontal">
                    <Button
                        android:layout_width="@dimen/_32sdp"
                        android:layout_height="@dimen/_30sdp"
                        android:text="1"
                        android:textStyle="bold"
                        android:background="@drawable/circle_bg"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_10sdp"/>
                    <LinearLayout
                        android:layout_width="@dimen/_20sdp"
                        android:layout_height="@dimen/_6sdp"
                        android:background="@drawable/search_layout_prog2"
                        android:orientation="horizontal"
                        android:layout_marginLeft="-1dp"
                        android:layout_marginRight="-1dp"
                        android:layout_gravity="center_vertical">

                        <ImageView
                            android:layout_width="@dimen/_10sdp"
                            android:layout_height="@dimen/_10sdp"
                            android:layout_gravity="center_vertical"
                            android:background="@color/red_bg"
                            />
                        <ImageView
                            android:layout_width="@dimen/_10sdp"
                            android:layout_height="@dimen/_10sdp"
                            android:layout_gravity="center_vertical"
                            android:background="@color/red_bg"/>
                    </LinearLayout>
                    <Button
                        android:layout_width="@dimen/_32sdp"
                        android:layout_height="@dimen/_30sdp"
                        android:text="2"
                        android:textStyle="bold"

                        android:background="@drawable/circle_bg"

                        android:textColor="@color/white"
                        android:textSize="@dimen/_10sdp"/>
                    <LinearLayout
                        android:layout_width="@dimen/_20sdp"
                        android:layout_height="@dimen/_6sdp"
                        android:layout_marginLeft="-1dp"
                        android:layout_marginRight="-1dp"
                        android:background="@drawable/search_layout_prog2"
                        android:orientation="horizontal"
                        android:layout_gravity="center_vertical">

                        <ImageView
                            android:layout_width="@dimen/_10sdp"
                            android:layout_height="@dimen/_10sdp"
                            android:layout_gravity="center_vertical"
                            android:background="@color/red_bg"
                            />
                        <ImageView
                            android:layout_width="@dimen/_10sdp"
                            android:layout_height="@dimen/_10sdp"
                            android:layout_gravity="center_vertical"
                            android:background="@color/red_bg"/>
                    </LinearLayout>
                    <Button
                        android:layout_width="@dimen/_32sdp"
                        android:layout_height="@dimen/_30sdp"
                        android:text="3"
                        android:textStyle="bold"

                        android:background="@drawable/circle_bg"

                        android:textColor="@color/white"
                        android:textSize="@dimen/_10sdp"/>
                    <LinearLayout
                        android:layout_width="@dimen/_20sdp"
                        android:layout_height="@dimen/_6sdp"
                        android:layout_marginLeft="-1dp"
                        android:layout_marginRight="-1dp"
                        android:background="@drawable/search_layout_prog2"
                        android:orientation="horizontal"
                        android:layout_gravity="center_vertical">

                        <ImageView
                            android:layout_width="@dimen/_10sdp"
                            android:layout_height="@dimen/_10sdp"
                            android:layout_gravity="center_vertical"
                            android:background="@color/red_bg"
                            />
                        <ImageView
                            android:layout_width="@dimen/_10sdp"
                            android:layout_height="@dimen/_10sdp"
                            android:layout_gravity="center_vertical"
                            />
                    </LinearLayout>
                    <Button
                        android:layout_width="@dimen/_32sdp"
                        android:layout_height="@dimen/_30sdp"
                        android:text="4"
                        android:textStyle="bold"

                        android:background="@drawable/circle_bg"

                        android:textColor="@color/white"
                        android:textSize="@dimen/_10sdp"/>
                    <LinearLayout
                        android:layout_width="@dimen/_20sdp"
                        android:layout_height="@dimen/_6sdp"
                        android:background="@drawable/search_layout_prog2"
                        android:orientation="horizontal"
                        android:layout_marginLeft="-1dp"
                        android:layout_marginRight="-1dp"
                        android:layout_gravity="center_vertical">

                        <ImageView
                            android:layout_width="@dimen/_10sdp"
                            android:layout_height="@dimen/_10sdp"
                            android:layout_gravity="center_vertical"
                            />
                        <ImageView
                            android:layout_width="@dimen/_10sdp"
                            android:layout_height="@dimen/_10sdp"
                            android:layout_gravity="center_vertical"
                          />
                    </LinearLayout>
                    <Button
                        android:layout_width="@dimen/_32sdp"
                        android:layout_height="@dimen/_30sdp"
                        android:text="5"
                        android:textStyle="bold"

                        android:background="@drawable/circle_bg"

                        android:textColor="@color/white"
                        android:textSize="@dimen/_10sdp"
                        />



                </LinearLayout>

                <LinearLayout
                    android:id="@+id/lin_basicinfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/_10sdp"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:layout_marginRight="@dimen/_10sdp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Upload Images"
                        android:textColor="@color/grey"
                        android:textStyle="bold" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="@dimen/_10sdp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Logo"
                            android:layout_weight="1"
                            android:textColor="@color/grey"
                            android:textStyle="normal" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Background Image"
                            android:layout_weight="1"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:textColor="@color/grey"
                            android:textStyle="normal" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">


                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_10sdp"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <ImageView
                                    android:layout_width="@dimen/_100sdp"
                                    android:layout_height="@dimen/_100sdp"
                                    android:src="@drawable/itaria" />

                                <TextView
                                    android:id="@+id/tv_upload_proof"
                                    android:layout_width="wrap_content"
                                    android:layout_height="@dimen/_23sdp"
                                    android:layout_marginTop="@dimen/_8sdp"
                                    android:background="@drawable/search_layout"
                                    android:backgroundTint="@color/blue_light"
                                    android:gravity="center"
                                    android:paddingHorizontal="@dimen/_10sdp"
                                    android:text="Upload Image"
                                    android:textColor="@color/white" />

                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="vertical">

                                <ImageView
                                    android:layout_width="@dimen/_100sdp"
                                    android:layout_height="@dimen/_100sdp"
                                    android:src="@drawable/placeholder2" />

                                <TextView
                                    android:id="@+id/tv_upload_proof22"
                                    android:layout_width="wrap_content"
                                    android:layout_height="@dimen/_23sdp"
                                    android:layout_marginTop="@dimen/_8sdp"
                                    android:background="@drawable/search_layout"
                                    android:backgroundTint="@color/blue_light"
                                    android:gravity="center"
                                    android:paddingHorizontal="@dimen/_10sdp"
                                    android:text="Additional Image"
                                    android:textColor="@color/white" />

                            </LinearLayout>

                        </LinearLayout>


                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_20sdp"
                        android:orientation="horizontal">


                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/TextInputLayoutStyle"
                            android:layout_width="match_parent"
                           android:textColorHint="@color/grey_font2"


                            android:layout_height="wrap_content">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/et_SOldPassword"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="start"
                                android:gravity="start"
                                android:hint="Youtube Video Link"
                                android:inputType="textVisiblePassword"
                                android:textColor="@color/black"
                                android:textColorHint="@color/grey"
                                 android:textSize="@dimen/_13sdp" />
                        </com.google.android.material.textfield.TextInputLayout>

                    </LinearLayout>
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginTop="@dimen/_40sdp"
                        android:layout_marginBottom="@dimen/_30sdp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btn_ssubmit3"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/_40sdp"
                            android:background="@drawable/btn_rounded_primary"
                            android:gravity="center"
                            android:text="NEXT"
                            android:textStyle="bold"
                            android:textAllCaps="false"
                            android:textColor="@android:color/white"
                            android:textSize="@dimen/_13sdp" />

                    </RelativeLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

    </androidx.core.widget.NestedScrollView>


</LinearLayout>