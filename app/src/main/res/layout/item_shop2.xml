<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@color/grey_light">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="@dimen/_145sdp"
        android:layout_height="@dimen/_200sdp"
        app:cardCornerRadius="0dp"
        android:id="@+id/card_subcat"
        app:strokeColor="@color/grey_light2222"
        app:strokeWidth="1sp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:background="@color/grey_light"
            android:orientation="vertical"
            android:padding="@dimen/_14sdp">

            <ImageView
                android:id="@+id/iv_hotdeal"
                android:layout_width="@dimen/_117sdp"
                android:layout_height="@dimen/_110sdp"
                android:scaleType="fitXY"
                android:src="@drawable/placeholder2" />

            <TextView
                android:id="@+id/tv_subcatname"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_4sdp"
                android:gravity="center"
                android:layout_gravity="center"
                android:text="@string/buy_product"
                android:textColor="@color/black"
                android:textSize="@dimen/_12sdp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/_3sdp"
                android:layout_marginTop="@dimen/_4sdp"
                android:text="@string/buy_product2"
                android:textColor="@color/black"
                android:visibility="gone"
                android:textSize="@dimen/_10sdp" />

        </LinearLayout>


    </com.google.android.material.card.MaterialCardView>


</RelativeLayout>