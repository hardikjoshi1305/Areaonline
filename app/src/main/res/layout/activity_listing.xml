<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/grey_lightest"
    tools:context=".user.activity.Listing_Activity">

  <androidx.constraintlayout.widget.ConstraintLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:id="@+id/tooltilte">
    <androidx.cardview.widget.CardView
        android:id="@+id/homeToolbarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/red_bg"
        android:elevation="@dimen/_4sdp"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
        android:orientation="vertical">

      <androidx.constraintlayout.widget.ConstraintLayout
          android:layout_width="match_parent"
          android:id="@+id/title"
          android:layout_height="@dimen/_45sdp">

        <TextView
            android:id="@+id/appTitleTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_10sdp"
            android:layout_marginLeft="@dimen/_10sdp"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:minHeight="@dimen/_30sdp"
            android:paddingStart="@dimen/_8sdp"
            android:paddingLeft="@dimen/_8sdp"
            android:paddingEnd="@dimen/_5sdp"
            android:paddingRight="@dimen/_5sdp"
            android:text="@string/app_name"
            android:fontFamily="@font/inter_semibold"
            android:textColor="@color/white"
            android:textSize="@dimen/_16sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@id/toggle"
            app:layout_constraintTop_toTopOf="parent" />
        <ImageView
            android:id="@+id/toggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_4sdp"
            android:layout_marginLeft="@dimen/_4sdp"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:minHeight="@dimen/_30sdp"
            android:paddingStart="@dimen/_8sdp"
            android:paddingLeft="@dimen/_8sdp"
            android:paddingEnd="@dimen/_5sdp"
            android:paddingRight="@dimen/_5sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_baseline_arrow_back_24"
            app:tint="@color/white" />


      </androidx.constraintlayout.widget.ConstraintLayout>
      <androidx.appcompat.widget.LinearLayoutCompat
          android:layout_width="match_parent"
          android:layout_height="@dimen/_50sdp"
          android:layout_below="@id/title"
          android:background="@color/red_bg"
          android:gravity="center"
          android:orientation="horizontal"

          android:paddingBottom="@dimen/_3sdp">

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_40sdp"
            android:layout_marginLeft="@dimen/_10sdp"
            android:layout_marginRight="@dimen/_10sdp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            >

          <com.google.android.material.textfield.TextInputEditText
              android:id="@+id/et_searchmain"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:layout_gravity="center_vertical"
              android:background="@drawable/round_ett"
              android:clickable="false"
              android:drawableLeft="@drawable/ic_baseline_search_24"
              android:drawablePadding="@dimen/_8sdp"
              android:drawableTint="@color/red_bg"
              android:focusable="false"
              android:gravity="center_vertical"
              android:hint="What are You looking for?"
              android:textSize="@dimen/_10sdp" />
        </com.google.android.material.textfield.TextInputLayout>
        <!--                <com.google.android.material.textfield.TextInputLayout-->
        <!--                    android:layout_width="match_parent"-->
        <!--                    android:layout_height="@dimen/_40sdp"-->
        <!--                    android:layout_weight="1"-->
        <!--                    android:layout_marginRight="@dimen/_5sdp"-->
        <!--                    android:gravity="center_vertical"-->
        <!--                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"-->

        <!--                    >-->
        <!--                    <com.google.android.material.textfield.TextInputEditText-->
        <!--                        android:layout_width="match_parent"-->
        <!--                        android:layout_height="match_parent"-->
        <!--                        android:gravity="center_vertical"-->
        <!--                        android:clickable="false"-->
        <!--                        android:focusable="false"-->
        <!--                        android:textSize="@dimen/_10sdp"-->
        <!--                        android:layout_gravity="center_vertical"-->
        <!--                        android:background="@drawable/round_ett"-->
        <!--                        android:drawableLeft="@drawable/ic_baseline_location_on_24"-->
        <!--                        android:drawableTint="@color/red_bg"-->
        <!--                        android:drawablePadding="@dimen/_4sdp"-->
        <!--                        android:hint="Enter Your Location"/>-->
        <!--                </com.google.android.material.textfield.TextInputLayout>-->

        <!--                <ImageView-->
        <!--                    android:layout_width="wrap_content"-->
        <!--                    android:layout_height="wrap_content"-->
        <!--                    android:padding="@dimen/_5sdp"-->
        <!--                    app:srcCompat="@drawable/ic_baseline_search_2"-->
        <!--                    android:scaleType="fitXY"-->

        <!--                    android:layout_marginRight="@dimen/_5sdp"-->
        <!--                    android:layout_gravity="center"-->
        <!--                    app:tint="@color/white" />-->


      </androidx.appcompat.widget.LinearLayoutCompat>
      </LinearLayout>

    </androidx.cardview.widget.CardView>
  </androidx.constraintlayout.widget.ConstraintLayout>
  <androidx.core.widget.NestedScrollView
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:layout_below="@id/tooltilte"

      android:id="@+id/nestesss">
  <RelativeLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
    android:paddingTop="@dimen/_7sdp">


    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rec_listing"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:nestedScrollingEnabled="true"
        android:paddingBottom="@dimen/_10sdp"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:spanCount="2"
        tools:itemCount="4"
        tools:listitem="@layout/item_listing" />
    <ProgressBar
        android:id="@+id/progresss"
        android:layout_width="@dimen/_24sdp"
        android:layout_height="@dimen/_24sdp"
        android:layout_below="@id/rec_listing"
        android:layout_centerInParent="true"
        android:indeterminateTint="@color/blue_light" />
  </RelativeLayout>
</androidx.core.widget.NestedScrollView>


</RelativeLayout>