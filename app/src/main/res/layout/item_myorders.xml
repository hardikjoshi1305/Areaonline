<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:scrollIndicators="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/_35sdp"
            android:layout_marginLeft="@dimen/_5sdp"
            android:layout_marginTop="@dimen/_5sdp"
            android:layout_marginRight="@dimen/_5sdp"
            android:background="@color/whiteCardColor"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_slno"
                android:layout_width="@dimen/_35sdp"
                android:layout_height="match_parent"
                android:background="@drawable/search_layout_black"
                android:gravity="center"
                android:text="1"
                android:textColor="@color/black"
                android:textSize="@dimen/_11sdp" />

            <TextView
                android:id="@+id/tv_companyname"
                android:layout_width="@dimen/_165sdp"
                android:layout_height="match_parent"
                android:background="@drawable/search_layout_black"
                android:gravity="center"
                android:text="Company Name"
                android:textColor="@color/black"
                android:textSize="@dimen/_11sdp" />

            <TextView
                android:id="@+id/tv_price"
                android:layout_width="@dimen/_60sdp"
                android:layout_height="match_parent"
                android:background="@drawable/search_layout_black"
                android:gravity="center"
                android:text="Price"
                android:textColor="@color/black"
                android:textSize="@dimen/_11sdp" />

            <LinearLayout
                android:layout_width="@dimen/_90sdp"
                android:layout_height="match_parent"
                android:background="@drawable/search_layout_black"
                android:gravity="center"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/line_status"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="@dimen/_7sdp"
                    android:layout_marginTop="@dimen/_3sdp"
                    android:layout_marginRight="@dimen/_7sdp"
                    android:layout_marginBottom="@dimen/_3sdp"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:background="@drawable/btn_rounded_primary"
                    android:backgroundTint="@color/blue_light"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:text="Delivered"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_10sdp" />
                </LinearLayout>

            </LinearLayout>

<!--            <TextView-->
<!--                android:id="@+id/tv_status"-->
<!--                android:layout_width="@dimen/_90sdp"-->
<!--                android:layout_height="match_parent"-->
<!--                android:background="@drawable/search_layout_black"-->
<!--                android:gravity="center"-->
<!--                android:text="Status"-->
<!--                android:textColor="@color/black"-->
<!--                android:textSize="@dimen/_11sdp" />-->

            <TextView
                android:id="@+id/tv_orderdate"
                android:layout_width="@dimen/_85sdp"
                android:layout_height="match_parent"
                android:background="@drawable/search_layout_black"
                android:gravity="center"
                android:text="Order Date"
                android:textColor="@color/black"
                android:textSize="@dimen/_11sdp" />

            <TextView
                android:id="@+id/tv_paymentmode"
                android:layout_width="@dimen/_110sdp"
                android:layout_height="match_parent"
                android:background="@drawable/search_layout_black"
                android:gravity="center"
                android:text="Payment Mode"
                android:textColor="@color/black"
                android:textSize="@dimen/_11sdp" />
            <LinearLayout
                android:layout_width="@dimen/_130sdp"
                android:layout_height="match_parent"
                android:background="@drawable/search_layout_black"
                android:gravity="center"
                android:paddingLeft="@dimen/_7sdp"
                android:paddingRight="@dimen/_7sdp"
                android:orientation="horizontal">
                <LinearLayout
                    android:id="@+id/line_info"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_28sdp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginRight="@dimen/_2sdp"
                    android:layout_weight="0.8"
                    android:background="@drawable/circle_bg"
                    android:backgroundTint="@color/blue_light"

                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:padding="@dimen/_7sdp"
                        android:layout_weight="0.8"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_baseline_info_24"
                        app:tint="@color/white" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/lin_viewdetail"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_28sdp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginRight="@dimen/_2sdp"
                    android:layout_weight="0.8"
                    android:visibility="visible"
                    android:background="@drawable/circle_bg"
                    android:backgroundTint="@color/green_valid"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:padding="@dimen/_7sdp"
                        android:layout_weight="0.8"
                        app:srcCompat="@drawable/ic_baseline_remove_red_eye_24"
                        app:tint="@color/white" />
                </LinearLayout>


                <LinearLayout
                    android:id="@+id/line_track"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_28sdp"
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/rounded_corners_popup"
                    android:layout_weight="1.6"
                    android:layout_marginRight="@dimen/_2sdp"
                    android:backgroundTint="@color/blue_light"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Track"
                        android:layout_weight="1.6"
                        android:gravity="center"
                        android:padding="@dimen/_7sdp"
                        android:textColor="@color/white"/>

<!--                    <ImageView-->
<!--                        android:layout_width="wrap_content"-->
<!--                        android:layout_height="match_parent"-->
<!--                        android:layout_gravity="center"-->
<!--                        android:layout_weight="1"-->
<!--                        android:padding="@dimen/_7sdp"-->
<!--                        app:srcCompat="@drawable/ic_baseline_delete_24"-->
<!--                        app:tint="@color/white" />-->

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </HorizontalScrollView>

</LinearLayout>