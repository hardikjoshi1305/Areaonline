<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:scrollIndicators="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/_35sdp"
        android:layout_marginLeft="@dimen/_5sdp"
        android:layout_marginTop="@dimen/_5sdp"
        android:layout_marginRight="@dimen/_5sdp"
        android:background="@color/whiteCardColor"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_srno"
            android:layout_width="@dimen/_35sdp"
            android:layout_height="match_parent"
            android:background="@drawable/search_layout_black"
            android:gravity="center"
            android:text="SI.No"
            android:textColor="@color/black"
             android:textSize="@dimen/_11sdp" />

        <TextView
            android:id="@+id/tv_checkno"
            android:layout_width="@dimen/_95sdp"
            android:layout_height="match_parent"
            android:background="@drawable/search_layout_black"
            android:gravity="center"
            android:text="Cheque No"
            android:textColor="@color/black"
             android:textSize="@dimen/_11sdp" />

        <TextView
            android:id="@+id/tv_amount"
            android:layout_width="@dimen/_60sdp"
            android:layout_height="match_parent"
            android:background="@drawable/search_layout_black"
            android:gravity="center"
            android:text="Amount"
            android:textColor="@color/black"
             android:textSize="@dimen/_11sdp" />

        <TextView
            android:id="@+id/tv_packagevalidity"
            android:layout_width="@dimen/_98sdp"
            android:layout_height="match_parent"
            android:background="@drawable/search_layout_black"
            android:gravity="center"
            android:text="Package Validity"
            android:textColor="@color/black"
             android:textSize="@dimen/_11sdp" />

        <TextView
            android:id="@+id/cheque_date"
            android:layout_width="@dimen/_95sdp"
            android:layout_height="match_parent"
            android:background="@drawable/search_layout_black"
            android:gravity="center"
            android:text="Cheque Submit Date"
            android:textColor="@color/black"
             android:textSize="@dimen/_11sdp" />

        <TextView
            android:id="@+id/tv_invoice"
            android:layout_width="@dimen/_90sdp"
            android:layout_height="match_parent"
            android:background="@drawable/search_layout_black"
            android:gravity="center"
            android:text="Invoice"
            android:textColor="@color/black"
            android:textSize="@dimen/_11sdp" />

    </LinearLayout>

    </HorizontalScrollView>

</LinearLayout>