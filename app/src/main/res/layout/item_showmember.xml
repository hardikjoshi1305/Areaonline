<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical">

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollIndicators="none"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/_35sdp"
            android:orientation="horizontal"
            android:background="@color/whiteCardColor"
            android:layout_marginLeft="@dimen/_5sdp"
            android:layout_marginRight="@dimen/_5sdp"
            android:layout_marginBottom="@dimen/_5sdp">

            <TextView
                android:id="@+id/tv_srno"
                android:layout_width="@dimen/_35sdp"
                android:layout_height="match_parent"
                android:background="@drawable/search_layout_black"
                android:gravity="center"
                android:text="1"
                android:textColor="@color/black"
                 android:textSize="@dimen/_11sdp" />

            <LinearLayout
                android:id="@+id/line_membername"

                android:layout_width="@dimen/_95sdp"
                android:layout_height="match_parent"
                android:background="@drawable/search_layout_black"
                android:gravity="center"

                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_membername"
                    android:layout_width="@dimen/_95sdp"
                    android:layout_height="match_parent"
                    android:background="@drawable/search_layout_black"
                    android:gravity="center"
                    android:text="Kheta Ram"
                    android:textColor="@color/blue_light"
                     android:textSize="@dimen/_11sdp" />
            </LinearLayout>


            <TextView
                android:id="@+id/tv_source"
                android:layout_width="@dimen/_60sdp"
                android:layout_height="match_parent"
                android:background="@drawable/search_layout_black"
                android:gravity="center"
                android:text="Vendor"
                android:textColor="@color/black"
                 android:textSize="@dimen/_11sdp" />

            <TextView
                android:id="@+id/tv_contactno"
                android:layout_width="@dimen/_80sdp"
                android:layout_height="match_parent"
                android:background="@drawable/search_layout_black"
                android:gravity="center"
                android:text="9272703566"
                android:textColor="@color/black"
                 android:textSize="@dimen/_11sdp" />

            <TextView
                android:id="@+id/tv_joindate"
                android:layout_width="@dimen/_85sdp"
                android:layout_height="match_parent"
                android:background="@drawable/search_layout_black"
                android:gravity="center"

                android:text="23-07-2021"
                android:textColor="@color/black"
                 android:textSize="@dimen/_11sdp" />

            <LinearLayout
                android:layout_width="@dimen/_110sdp"
                android:layout_height="match_parent"
                android:background="@drawable/search_layout_black"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginLeft="@dimen/_6sdp"
                    android:layout_marginRight="@dimen/_6sdp"
                    android:gravity="center"
                    android:orientation="horizontal">


                    <TextView
                        android:id="@+id/tv_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:singleLine="true"
                        android:text="Active"
                        android:textColor="@color/black"
                         android:textSize="@dimen/_11sdp" />


                </LinearLayout>


            </LinearLayout>

            <LinearLayout
                android:layout_width="@dimen/_90sdp"
                android:layout_height="match_parent"
                android:background="@drawable/search_layout_black"
                android:gravity="center"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/line_exit"
                    android:layout_width="@dimen/_24sdp"
                    android:layout_height="@dimen/_24sdp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginRight="@dimen/_2sdp"
                    android:background="@drawable/circle_bg"
                    android:backgroundTint="@color/green"

                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_weight="1"
                        app:srcCompat="@drawable/ic_baseline_logout_242"
                        app:tint="@color/white" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/line_edit_channel"
                    android:layout_width="@dimen/_24sdp"
                    android:layout_height="@dimen/_24sdp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginRight="@dimen/_2sdp"
                    android:background="@drawable/circle_bg"
                    android:backgroundTint="@color/blue_light"

                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_weight="1"
                        app:srcCompat="@drawable/ic_baseline_border_color_24"
                        app:tint="@color/white" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/line_delete"
                    android:layout_width="@dimen/_24sdp"
                    android:layout_height="@dimen/_24sdp"
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/circle_bg"
                    android:backgroundTint="@color/black"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_weight="1"
                        app:srcCompat="@drawable/ic_baseline_delete_24"
                        app:tint="@color/white" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>



    </HorizontalScrollView>

</LinearLayout>