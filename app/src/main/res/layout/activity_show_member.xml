<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"

    android:background="@color/grey_lightest"
    tools:context=".channelpartner.activity.ShowMemberActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/_10sdp"
        android:layout_marginTop="@dimen/_18sdp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Member / Customer"
                    android:textStyle="bold"
                    android:textColor="@color/red_bg"
                    android:textSize="@dimen/_16sdp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:layout_marginRight="@dimen/_10sdp"
                    android:gravity="center"

                    android:background="@drawable/btn_rounded_primary"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/_18sdp"
                        android:layout_height="@dimen/_18sdp"
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/ic_baseline_refresh_24"
                        />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginLeft="@dimen/_4sdp"
                        android:text="Refresh"
                        android:textColor="@color/white"
                         android:textSize="@dimen/_11sdp" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_11sdp"
                android:orientation="horizontal"
                android:visibility="gone">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_40sdp"
                    android:layout_marginLeft="@dimen/_35sdp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_rounded_primary"

                    android:backgroundTint="@color/red_bg"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/_18sdp"
                        android:layout_height="@dimen/_18sdp"
                        android:layout_gravity="center_vertical"
                        android:layout_marginLeft="@dimen/_7sdp"
                        android:background="@drawable/ic_baseline_add_24"
                        android:paddingLeft="@dimen/_5sdp"
                        android:text="Add Shop Details" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginLeft="@dimen/_4sdp"
                        android:paddingRight="@dimen/_5sdp"
                        android:text="Add Shop Details"

                        android:textColor="@color/white"
                         android:textSize="@dimen/_11sdp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_40sdp"
                    android:layout_marginRight="@dimen/_10sdp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_rounded_primary"

                    android:backgroundTint="@color/red_bg"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/_18sdp"
                        android:layout_height="@dimen/_18sdp"
                        android:layout_gravity="center_vertical"
                        android:layout_marginLeft="@dimen/_7sdp"
                        android:background="@drawable/ic_baseline_add_24"
                        android:paddingLeft="@dimen/_5sdp"
                        android:scaleType="centerCrop"
                        android:text="Add Shop Details" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginLeft="@dimen/_4sdp"
                        android:paddingRight="@dimen/_5sdp"

                        android:text="Add Product &amp; Services"
                        android:textColor="@color/white"
                         android:textSize="@dimen/_11sdp" />

                </LinearLayout>
            </LinearLayout>

        </LinearLayout>


    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_7sdp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingLeft="@dimen/_12sdp"
            android:paddingTop="@dimen/_10sdp"
            android:paddingRight="@dimen/_12sdp"
            android:paddingBottom="@dimen/_10sdp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:gravity="center_vertical"
                android:text="Show"
                android:textColor="@color/grey"
                 android:textSize="@dimen/_11sdp"
                android:visibility="invisible" />

            <LinearLayout
                android:layout_width="@dimen/_44sdp"

                android:layout_height="@dimen/_24sdp"
                android:layout_marginLeft="@dimen/_5sdp"
                android:background="@drawable/square_button_white"
                android:orientation="horizontal"
                android:visibility="invisible"
                app:backgroundTint="@color/white">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="10"
                    android:textColor="@color/black"
                     android:textSize="@dimen/_11sdp" />

                <ImageView
                    android:layout_width="@dimen/_20sdp"
                    android:layout_height="@dimen/_20sdp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginRight="@dimen/_4sdp"
                    android:layout_weight="1"
                    android:src="@drawable/ic_arrow_down"
                    app:tint="@color/black" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginLeft="@dimen/_5sdp"

                android:gravity="center_vertical"
                android:text="entries"
                android:textColor="@color/grey"
                 android:textSize="@dimen/_11sdp"
                android:visibility="invisible" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:gravity="end"
                android:visibility="gone"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginLeft="@dimen/_5sdp"
                    android:gravity="center_vertical"
                    android:text="Search : "
                    android:textStyle="bold"
                    android:textColor="@color/grey"
                     android:textSize="@dimen/_11sdp" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                    android:layout_width="@dimen/_70sdp"
                    android:layout_height="match_parent"
                    android:layout_gravity="center_vertical"
                   android:textColorHint="@color/grey_font2"
>

                    <com.google.android.material.textfield.TextInputEditText
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

        </LinearLayout>


        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollIndicators="none"
            android:scrollbars="none">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/_3sdp"
                android:layout_marginBottom="@dimen/_25sdp"
                app:strokeColor="@color/grey_lightest"
                android:layout_marginTop="@dimen/_7sdp"
                app:strokeWidth="@dimen/_1sdp"
                app:cardBackgroundColor="@color/grey_lightest"
                android:layout_marginRight="@dimen/_10sdp"
                app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/grey_lightest"
                android:layout_marginRight="@dimen/_7sdp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_35sdp"
                    android:orientation="horizontal"
                    android:background="@color/whiteCardColor"
                    android:layout_marginLeft="@dimen/_5sdp"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:layout_marginRight="@dimen/_5sdp">

                    <TextView
                        android:layout_width="@dimen/_35sdp"
                        android:layout_height="match_parent"
                        android:background="@drawable/search_layout_black"
                        android:gravity="center"
                        android:text="SI.No"
                        android:textColor="@color/black"
                         android:textSize="@dimen/_11sdp" />

                    <TextView
                        android:layout_width="@dimen/_95sdp"
                        android:layout_height="match_parent"
                        android:background="@drawable/search_layout_black"
                        android:gravity="center"
                        android:text="Member Name"
                        android:textColor="@color/black"
                         android:textSize="@dimen/_11sdp" />

                    <TextView
                        android:layout_width="@dimen/_60sdp"
                        android:layout_height="match_parent"
                        android:background="@drawable/search_layout_black"
                        android:gravity="center"
                        android:text="Source"
                        android:textColor="@color/black"
                         android:textSize="@dimen/_11sdp" />

                    <TextView
                        android:layout_width="@dimen/_80sdp"
                        android:layout_height="match_parent"
                        android:background="@drawable/search_layout_black"
                        android:gravity="center"
                        android:text="Contact No."
                        android:textColor="@color/black"
                         android:textSize="@dimen/_11sdp" />

                    <TextView
                        android:layout_width="@dimen/_85sdp"
                        android:layout_height="match_parent"
                        android:background="@drawable/search_layout_black"
                        android:gravity="center"

                        android:text="Join Date"
                        android:textColor="@color/black"
                         android:textSize="@dimen/_11sdp" />

                    <TextView
                        android:layout_width="@dimen/_110sdp"
                        android:layout_height="match_parent"
                        android:background="@drawable/search_layout_black"
                        android:gravity="center"
                        android:text="Status"


                        android:textColor="@color/black"
                         android:textSize="@dimen/_11sdp" />

                    <TextView
                        android:layout_width="@dimen/_90sdp"
                        android:layout_height="match_parent"
                        android:background="@drawable/search_layout_black"
                        android:gravity="center"
                        android:text="Action"
                        android:textColor="@color/black"
                         android:textSize="@dimen/_11sdp" />

                </LinearLayout>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rec_showmember"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    tools:listitem="@layout/item_showmember"/>

                <LinearLayout
                    android:id="@+id/line_nodata"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_35sdp"
                    android:layout_marginLeft="@dimen/_5sdp"
                    android:layout_marginRight="@dimen/_5sdp"
                    android:layout_marginBottom="@dimen/_5sdp"
                    android:background="@drawable/search_layout_black"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:layout_margin="@dimen/_1sdp"
                        android:background="@color/whiteCardColor"
                        android:gravity="center"
                        android:text="No Data Available"
                        android:textColor="@color/black"
                         android:textSize="@dimen/_11sdp" />


                </LinearLayout>

            </LinearLayout>
            </com.google.android.material.card.MaterialCardView>



        </HorizontalScrollView>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_6sdp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_weight="1"
            android:paddingLeft="@dimen/_14sdp"
            android:text="Showing 1 to 1 entries"
            android:textColor="@color/grey"
            android:textSize="@dimen/_8sdp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginRight="@dimen/_3sdp"
            android:paddingRight="@dimen/_5sdp"
            android:text="Previous "
            android:textColor="@color/grey"
            android:textSize="@dimen/_8sdp" />

        <LinearLayout
            android:layout_width="@dimen/_24sdp"
            android:layout_height="@dimen/_24sdp"
            android:background="@drawable/square_button"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_weight="1"
                android:gravity="center"
                android:text="1"
                android:textColor="@color/black"
                 android:textSize="@dimen/_11sdp" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginLeft="@dimen/_3sdp"
            android:paddingRight="@dimen/_5sdp"
            android:text="Next "
            android:textColor="@color/grey"
            android:textSize="@dimen/_8sdp" />

    </LinearLayout>

</LinearLayout>