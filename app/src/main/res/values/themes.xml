<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.AreaOnline" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/red_bg</item>
        <item name="colorPrimaryVariant">@color/red_bg</item>
        <item name="colorOnPrimary">@color/grey_lightest</item>
        <item name="colorAccent">@color/grey_font</item>
        <item name="android:textColorSecondary">@color/red_bg</item>
        <item name="android:textColorHint">@color/grey_font</item>

        <item name="background">@color/grey_lightest</item>
        <item name="backgroundColor">@color/grey_lightest</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:fontFamily">@font/inter_regular</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor" tools:targetApi="l">@color/red_bg</item>
        <!-- Customize your theme here. -->
    </style>
    <style name="Widget.MaterialComponents.LinearProgressIndicator111" parent="Widget.MaterialComponents.ProgressIndicator">
        <item name="indeterminateAnimationType">disjoint</item>
        <item name="android:windowIsFloating">true</item>
        <item name="indicatorDirectionLinear">startToEnd</item>
    </style>
    <style name="AppCompatAlertDialogStyle" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="colorAccent">@color/red_bg</item>
        <item name="android:textColorPrimary">@color/black</item>
        <item name="android:background">@color/white</item>
    </style>
    <style name="Theme.AreaOnline2" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/red_bg</item>
        <item name="colorPrimaryVariant">@color/red_bg</item>
        <item name="colorOnPrimary">@color/grey_lightest</item>
        <item name="background">@color/grey_lightest</item>
        <item name="android:textColorSecondary">@color/red_bg</item>

        <item name="backgroundColor">@color/grey_lightest</item>
        <item name="android:textColorHint">@color/grey_font</item>

        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:fontFamily">@font/inter_regular</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor" tools:targetApi="l">@color/red_bg</item>
        <!-- Customize your theme here. -->
    </style>

    <style name="MyCardView" parent="@style/Widget.MaterialComponents.CardView">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.MaterialCardView.Cut</item>
    </style>
    <style name="MyDialogTheme" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="android:background">@color/white</item>
        <item name="android:colorAccent">@color/red_bg</item>
        <item name="colorPrimary">@color/red_bg</item>
        <item name="colorPrimaryVariant">@color/red_bg</item>
        <item name="android:textColorSecondary">@color/red_bg</item>



    </style>


    <style name="ShapeAppearanceOverlay.MaterialCardView.Cut" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopRight">@dimen/_2sdp</item>
        <item name="cornerSizeTopLeft">@dimen/_2sdp</item>
        <item name="cornerSizeBottomRight">@dimen/_10sdp</item>
        <item name="cornerSizeBottomLeft">@dimen/_10sdp</item>
    </style>
    <style name="Theme.listing" parent="Theme.AppCompat.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/red_bg</item>
        <item name="colorPrimaryVariant">@color/red_bg</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="title">@string/app_name</item>
        <item name="titleTextColor">@color/white</item>
        <item name="android:fontFamily">@font/inter_regular</item>

        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor" tools:targetApi="l">@color/red_bg</item>


    </style>



    <style name="TextInputLayoutStyle" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense">
        <item name="boxStrokeColor">@color/box_stork_color</item>
        <item name="cornerFamilyBottomLeft">@dimen/_2sdp</item>
        <item name="cornerFamilyBottomRight">@dimen/_2sdp</item>
        <item name="cornerFamilyTopLeft">@dimen/_2sdp</item>
        <item name="cornerFamilyTopRight">@dimen/_2sdp</item>

    </style>

    <!--designs login_bkogin and register-->
    <style name="parent" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColorHint">@color/grey_font2</item>

        <item name="boxStrokeColor">@color/black</item>


    </style>

    <style name="loginParent" parent="parent">
        <item name="android:layout_height">match_parent</item>
        <item name="android:background">@color/loginBkColor</item>
        <item name="android:focusableInTouchMode">true</item>
    </style>

    <style name="headerText" parent="parent">
        <item name="android:textSize">@dimen/headerTextSize</item>
        <item name="android:textAlignment" tools:ignore="NewApi">center</item>
        <item name="android:textColor">@color/whiteTextColor</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="loginHeader">
        <item name="android:textColor">@color/red</item>
        <item name="android:textSize">@dimen/headerTextSize</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="loginCard" parent="parent"></style>

    <style name="linearParent" parent="parent">
        <item name="android:orientation">vertical</item>
    </style>



    <style name="modifiedEditText" parent="parent">
        <item name="android:textSize">@dimen/newsMoreTextSize</item>
        <item name="android:textColor">@color/black</item>
        <item name="colorControlActivated">@color/grey_font</item>
        <item name="colorControlHighlight">@color/grey_font</item>
        <item name="colorControlNormal">@color/grey_font</item>
<!--        <item name="android:textColorHint">@color/grey_font</item>-->
        <item name="android:backgroundTint" tools:ignore="NewApi">@color/red_bg</item>

    </style>
    <style name="modifiedEditText2" parent="parent">
        <item name="android:textSize">@dimen/newsMoreTextSize</item>
        <item name="android:backgroundTint" tools:ignore="NewApi">@color/white</item>
        <item name="colorControlActivated">@color/grey_font</item>
        <item name="colorControlHighlight">@color/grey_font</item>
        <item name="colorControlNormal">@color/grey_font</item>
<!--        <item name="android:textColorHint">@color/grey_font</item>-->

        <item name="android:textColor">@color/black</item>


    </style>

    <style name="viewParent" parent="Theme.MaterialComponents">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="loginButton" parent="viewParent">
        <item name="android:background">@drawable/login_button_bk</item>
        <item name="android:textColor">@color/whiteTextColor</item>
        <item name="android:textStyle">bold</item>
    </style>

</resources>